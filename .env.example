# Copy to .env and fill ONE block. Swapping models = changing these lines.

# --- Google Gemini (free tier: https://aistudio.google.com/apikey)
PROVIDER=gemini
MODEL=gemini-2.5-flash
GEMINI_API_KEY=paste-your-key-here

# --- Any OpenAI-compatible API (Groq free tier, OpenRouter, OpenAI, a company gateway)
# PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=...

# --- Anthropic
# PROVIDER=anthropic
# MODEL=claude-haiku-5-5        # or claude-sonnet-5-5 (stronger, ~20x cost)
# ANTHROPIC_API_KEY=...

# --- No key: rule-based baseline
# PROVIDER=offline

# seconds to wait between live calls (free tiers are rate-limited)
LLM_SLEEP=4
